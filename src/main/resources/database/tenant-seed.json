  "forms": [
    {
      "name": "Contact Us",
      "unique_id": "contact-us",
      "use_captcha": true,
      "check_for_spam": true,
      "button_name": "Submit",
      "success_message": "Thank you for contacting us. We normally respond within 1-2 business days.",
      "fields": [
        {
          "label": "Reason for contacting us",
          "value": "reason",
          "type": "list",
          "options": [
            "Ask a question",
            "Provide feedback",
            "Request support",
            "Other"
          ],
          "required": true
        },
        {
          "label": "First Name",
          "value": "firstName",
          "type": "text",
          "placeholder": "Your first name",
          "required": true
        },
        {
          "label": "Last Name",
          "value": "lastName",
          "type": "text",
          "placeholder": "Your last name",
          "required": true
        },
        {
          "label": "Email Address",
          "value": "email",
          "type": "email",
          "placeholder": "Your email address",
          "required": true
        },
        {
          "label": "Phone Number",
          "intro": "To ensure we are getting you the information you seek, we may need to contact you by phone to get some clarification.",
          "value": "phone",
          "type": "text",
          "placeholder": "Your phone number",
          "required": false
        },
        {
          "label": "Who would you like to contact?",
          "value": "who",
          "type": "list",
          "options": [
            "Sales",
            "Marketing",
            "Technical Support",
            "Other"
          ],
          "required": true
        },
        {
          "label": "Message",
          "value": "message",
          "type": "textarea",
          "placeholder": "Your message",
          "required": true
        }
      ]
    }
