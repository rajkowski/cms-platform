<template name="Document Home Page with Search" image="Document Home Page.png">
  <page>
    <section class="margin-top-10 margin-bottom-50 welcome-card align-center text-center no-gap-all">
      <column class="small-12 cell">
        <widget name="content">
          <uniqueId>${webPageName}-welcome</uniqueId>
          <html><![CDATA[Welcome to the site]]></html>
        </widget>
      </column>
      <column class="small-12 medium-9 cell">
        <widget name="searchForm" class="landing-page-search">
          <placeholder>Search the site...</placeholder>
          <linkText>Search</linkText>
          <expand>false</expand>
        </widget>
      </column>
    </section>
    <section class="margin-bottom-50">
      <column class="small-12 cell text-center">
        <widget name="content">
          <uniqueId>${webPageName}-headline</uniqueId>
          <html><![CDATA[This can be a headline about modules]]></html>
        </widget>
        <!-- <widget name="itemsList">
          <title>Popular Topics</title>
          <uniqueId>popular-topics</uniqueId>
          <showWhenEmpty>true</showWhenEmpty>
          <collectionUniqueId>populartopics-properties</collectionUniqueId>
          <view>tags</view>
          <limit>-1</limit>
          <useUserRegion>true</useUserRegion>
          <showLink>true</showLink>
          <showCollectionIcon>true</showCollectionIcon>
          <sortBy>custom.Sort Order</sortBy>
        </widget> -->
      </column>
    </section>
    <section class="margin-bottom-50 text-center">
      <column class="small-6 medium-4 large-3 inline-card secondary radius cell">
        <widget name="content" class="padding-top-20">
          <uniqueId>${webPageName}-module-1</uniqueId>
          <html><![CDATA[Module content]]></html>
        </widget>
      </column>
      <column class="small-6 medium-4 large-3 inline-card secondary radius cell">
        <widget name="content" class="padding-top-20">
          <uniqueId>${webPageName}-module-2</uniqueId>
          <html><![CDATA[Module content]]></html>
        </widget>
      </column>
      <column class="small-6 medium-4 large-3 inline-card secondary radius cell">
        <widget name="content" class="padding-top-20">
          <uniqueId>${webPageName}-module-3</uniqueId>
          <html><![CDATA[Module content]]></html>
        </widget>
      </column>
      <column class="small-6 medium-4 large-3 inline-card secondary radius cell">
        <widget name="content" class="padding-top-20">
          <uniqueId>${webPageName}-module-4</uniqueId>
          <html><![CDATA[Module content]]></html>
        </widget>
      </column>
    </section>
  </page>
</template>
