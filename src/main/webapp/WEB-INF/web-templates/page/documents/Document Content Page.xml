<template name="Document Content Page" image="Document Content Page.png">
  <page>
    <section>
      <column class="small-12 cell">
        <widget name="pageBreadcrumb">
          <showRootPage>false</showRootPage>
        </widget>
      </column>
    </section>
    <section>
      <column class="small-12 cell">
        <widget name="pageSummary" />
      </column>
    </section>
    <section>
      <column class="small-12 medium-auto medium-order-1 small-order-2 cell">
        <widget name="content">
          <uniqueId>${webPageName}-content</uniqueId>
        </widget>
        <widget name="pageChildren">
          <maxDepth>1</maxDepth>
        </widget>
        <widget name="pageLabels" />
      </column>
      <column class="small-12 medium-4 cell medium-order-2 small-order-1" sticky="true">
        <widget name="pageTableOfContents">
          <uniqueId>${webPageName}-content</uniqueId>
        </widget>
      </column>
    </section>
  </page>
</template>
