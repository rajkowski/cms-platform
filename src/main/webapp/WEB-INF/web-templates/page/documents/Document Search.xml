<template name="Document Search Results" image="Document Search Results.png">
  <page>
    <section>
      <!-- Search filter sidebar -->
      <column class="small-12 medium-3 large-2 cell">
        <widget name="searchFilterSidebar" class="callout box">
          <useRegions>false</useRegions>
          <useTypes>true</useTypes>
          <useTags>true</useTags>
          <useLastModified>false</useLastModified>
          <useContributors>false</useContributors>
        </widget>
      </column>
      <!-- Main content area -->
      <column class="small-12 medium-auto cell search-main-content no-padding">
        <widget name="searchForm" class="landing-page-search max-width-600">
          <title>Search</title>
          <placeholder>Search the site...</placeholder>
          <linkText>Search</linkText>
          <expand>false</expand>
        </widget>
        <widget name="searchInfo" class="callout box margin-bottom-50" />
        <widget name="webPageTitleSearchResults">
          <title>Pages found:</title>
          <showWhenEmpty>false</showWhenEmpty>
        </widget>
        <!-- Main Results Area -->
        <widget name="calendarSearchResults">
          <title>Upcoming Event:</title>
          <limit>1</limit>
          <showWhenEmpty>false</showWhenEmpty>
          <showWhenOfType>all</showWhenOfType>
        </widget>
        <widget name="webPageSearchResults">
          <title>Web Pages Found:</title>
          <limit>10</limit>
          <showWhenEmpty>true</showWhenEmpty>
          <useUserRegion>true</useUserRegion>
          <showPaging>true</showPaging>
          <showWhenOfType>all</showWhenOfType>
        </widget>
        <!-- Tied to the filter type -->
        <widget name="webPageSearchResults">
          <title>Web Pages Found:</title>
          <limit>10</limit>
          <showWhenEmpty>true</showWhenEmpty>
          <useUserRegion>true</useUserRegion>
          <showPaging>true</showPaging>
          <showWhenOfType>pages</showWhenOfType>
        </widget>
        <widget name="blogPostSearchResults">
          <title>Posts Found:</title>
          <limit>10</limit>
          <showWhenEmpty>true</showWhenEmpty>
          <showWhenOfType>posts</showWhenOfType>
        </widget>
        <widget name="itemsSearchResults">
          <title>Resources Found:</title>
          <limit>10</limit>
          <showWhenEmpty>true</showWhenEmpty>
          <useItemLink>false</useItemLink>
          <useUserRegion>true</useUserRegion>
          <showPaging>true</showPaging>
          <showWhenOfType>resources</showWhenOfType>
        </widget>
        <widget name="fileSearchResults">
          <title>Attachments Found:</title>
          <limit>10</limit>
          <showWhenEmpty>true</showWhenEmpty>
          <showPaging>true</showPaging>
          <showWhenOfType>attachments</showWhenOfType>
        </widget>
        <widget class="margin-50" name="content">
          <uniqueId>${webPageName}-footer</uniqueId>
          <html><![CDATA[<p>You can also review the <a href="/all-faqs">FAQs</a></p>]]></html>
        </widget>
      </column>
      <column class="small-12 medium-4 large-3 cell">
        <widget name="blogPostSearchResults" class="callout box">
          <title>Posts Found:</title>
          <limit>5</limit>
          <showWhenEmpty>false</showWhenEmpty>
          <showViewMoreLink>true</showViewMoreLink>
          <showWhenOfType>all</showWhenOfType>
        </widget>
        <widget name="itemsSearchResults" class="callout box">
          <title>Resources Found:</title>
          <limit>5</limit>
          <showWhenEmpty>false</showWhenEmpty>
          <useItemLink>false</useItemLink>
          <useUserRegion>true</useUserRegion>
          <showViewMoreLink>true</showViewMoreLink>
          <showWhenOfType>all</showWhenOfType>
        </widget>
        <widget name="fileSearchResults" class="callout box">
          <title>Attachments Found:</title>
          <limit>5</limit>
          <showWhenEmpty>false</showWhenEmpty>
          <showViewMoreLink>true</showViewMoreLink>
          <showWhenOfType>all</showWhenOfType>
        </widget>
      </column>
    </section>
  </page>
</template>
