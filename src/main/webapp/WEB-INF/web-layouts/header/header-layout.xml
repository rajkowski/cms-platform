<?xml version="1.0" ?>
<headers>
  
  <header name="header.plain" title="Logo">
    <section>
      <column class="small-12 cell text-center">
        <widget name="logo">
          <maxHeight>45px</maxHeight>
        </widget>
      </column>
    </section>
  </header>

  <header name="header.default" title="Default Modern Header" sticky="true" scrollBehavior="hide-on-down" scrollThreshold="100">
    <section class="announcement-bar utility-bar" container="grid">
      <column wrapper="none">
        <widget name="systemAlert"></widget>
      </column>
    </section>
    <section class="main-header" container="header">
      <column wrapper="none">
        <widget name="logo"></widget>
      </column>
      <column wrapper="none">
        <widget name="headerControl"><type>mobileMenu</type></widget>
      </column>
      <column class="header-actions">
        <widget name="searchControl"><minChars>3</minChars><debounceMs>300</debounceMs></widget>
        <widget name="headerControl"><type>askAI</type></widget>
        <!-- <widget name="menu"><links><link name="Calendar" link="/calendar" icon="fa-calendar" /></links></widget> -->
        <!-- <widget name="menu"><links><link name="Directory" link="/directory" icon="fa-address-book" /></links></widget> -->
        <widget name="headerControl"><type>region</type></widget>
        <widget name="menu">
          <links>
            <link name="Contact" link="/contact-us" icon="fa-envelope" />
          </links>
        </widget>
        <widget name="headerAccountMenu">
          <links>
            <link action="pageInfo" section="page" sectionLabel="Page Tools" name="Page Info" icon="fa-info-circle" />
            <link action="pageAnalytics" section="page" sectionLabel="Page Tools" name="Page Analytics" icon="fa-chart-area" />
            <link action="pageDesign" section="page" sectionLabel="Page Tools" name="Page Design" icon="fa-file-lines" />
            <link action="files" section="content" sectionLabel="Content Tools" name="All Files" icon="fa-folder-open" />
            <link action="images" section="content" sectionLabel="Content Tools" name="All Images" icon="fa-image" />
            <link action="hierarchy" section="content" sectionLabel="Content Tools" name="Page Hierarchy" icon="fa-sitemap" />
            <link action="instructions" section="admin" sectionLabel="Admin Tools" name="Instructions" icon="fa-circle-info" />
            <link action="siteAnalytics" section="admin" sectionLabel="Admin Tools" name="Site Analytics" icon="fa-chart-line" />
            <link action="users" section="admin" sectionLabel="Admin Tools" name="Users" icon="fa-users" />
            <link action="announcement" section="admin" sectionLabel="Admin Tools" name="Announcement" icon="fa-bullhorn" />
            <link action="siteCss" section="admin" sectionLabel="Admin Tools" name="Site CSS" icon="fa-brands fa-css" />
            <link action="setup" section="admin" sectionLabel="Admin Tools" name="Setup" icon="fa-cog" />
            <link action="appearance" name="Toggle Light/Dark Mode" icon="fa-moon" />
            <link action="account" name="My Account" icon="fa-user-cog" />
            <link action="logout" name="Logout" icon="fa-sign-out-alt" />
          </links>
        </widget>
        <widget name="headerControl" role="guest"><type>appearance</type></widget>
        <widget name="menu" role="guest">
          <links>
            <link name="Login" link="/login" icon="fa-sign-in-alt" class="primary" />
            <link name="Register" link="/register" icon="fa-user-plus" class="primary" rule="site.registrations" />
          </links>
        </widget>
        <widget name="cartMenu"></widget>
        <widget name="headerControl" role="users"><type>workspaces</type></widget>
      </column>
      <column wrapper="none">
        <widget name="mainMenu"><omitFirstHomeItem>true</omitFirstHomeItem></widget>
      </column>
    </section>
  </header>
</headers>
