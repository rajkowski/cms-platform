<%@ page contentType="text/html; charset=UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<%@ taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions" %>
<%@ taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt" %>
<%@ taglib prefix="g" uri="http://granule.com/tags" %>
<c:set var="adminPagePath" value="${not empty pageRenderInfo.pagePath ? pageRenderInfo.pagePath : masterWebPage.link}" />
<g:compress>
  <link rel="stylesheet" href="${ctx}/css/layout-header-modern.css">
</g:compress>
<header id="platform-menu" class="modern-header" data-theme="${theme}">
  <%-- Announcement Bar --%>
  <c:if test="${!empty sitePropertyMap['site.header.line1']}">
    <div class="announcement-bar utility-bar">
      <div class="grid-container">
        <p>
          <c:out value="${sitePropertyMap['site.header.line1']}" />
          <c:if test="${!empty sitePropertyMap['site.header.page']}">
            <c:choose>
              <c:when test="${!empty sitePropertyMap['site.header.link']}">
                <a style="white-space: nowrap" href="${ctx}${sitePropertyMap['site.header.page']}"><c:out value="${sitePropertyMap['site.header.link']}" /></a>
              </c:when>
              <c:otherwise>
                <a href="${ctx}${sitePropertyMap['site.header.page']}">Details</a>
              </c:otherwise>
            </c:choose>
          </c:if>
          <c:if test="${userSession.hasRole('admin')}">
            <a class="hollow button tiny secondary" style="padding:2px; margin:0;" href="${ctx}/admin/site-header-properties"><i class="${font:fas()} fa-edit"></i></a>
          </c:if>
        </p>
      </div>
    </div>
  </c:if>

  <%-- Main Header --%>
  <div class="main-header">
    <div class="header-container">
      <%-- Logo/Brand --%>
      <a href="/" class="header-logo">
        <c:choose>
          <c:when test="${!empty sitePropertyMap['site.logo']}">
            <img class="logo-light" src="${sitePropertyMap['site.logo']}" alt="<c:out value="${sitePropertyMap['site.name']}"/>" />
            <c:choose>
              <c:when test="${!empty sitePropertyMap['site.logo.mixed']}">
                <img class="logo-dark" src="${sitePropertyMap['site.logo.mixed']}" alt="<c:out value="${sitePropertyMap['site.name']}"/>" />
              </c:when>
              <c:when test="${!empty sitePropertyMap['site.logo.white']}">
                <img class="logo-dark" src="${sitePropertyMap['site.logo.white']}" alt="<c:out value="${sitePropertyMap['site.name']}"/>" />
              </c:when>
              <c:otherwise>
                <img class="logo-dark" src="${sitePropertyMap['site.logo']}" alt="<c:out value="${sitePropertyMap['site.name']}"/>" />
              </c:otherwise>
            </c:choose>
          </c:when>
          <c:otherwise>
            <i class="${font:fas()} fa-cube"></i>
            <span><c:out value="${sitePropertyMap['site.name']}"/></span>
          </c:otherwise>
        </c:choose>
      </a>

      <%-- Main Navigation --%>
      <nav class="header-nav" id="mainNav">
        <ul class="nav-menu">
          <c:forEach items="${masterMenuTabList}" var="menuItem" varStatus="menuTabStatus">            
            <c:if test="${not (menuItem.link eq '/' && menuTabStatus.index == 0)}">
              <li class="nav-item${not empty menuItem.menuItemList ? ' has-dropdown' : ''}">
                <a href="${menuItem.link}" class="nav-link${menuItem.active ? ' active' : ''}">
                  <c:if test="${not empty menuItem.icon}">
                    <i class="${menuItem.icon}"></i>
                  </c:if>
                  <c:out value="${menuItem.name}" />
                  <c:if test="${not empty menuItem.menuItemList}">
                    <i class="${font:fas()} fa-chevron-down" style="font-size: 0.75rem; margin-left: 0.25rem;"></i>
                  </c:if>
                </a>
                <%-- Dropdown Menu --%>
                <c:if test="${not empty menuItem.menuItemList}">
                  <div class="dropdown-menu">
                    <c:forEach items="${menuItem.menuItemList}" var="subItem">
                      <a href="${subItem.link}" class="dropdown-item${subItem.active ? ' active' : ''}">
                        <c:if test="${not empty subItem.icon}">
                          <i class="${subItem.icon}" style="margin-right: 0.5rem;"></i>
                        </c:if>
                        ${subItem.name}
                      </a>
                    </c:forEach>
                  </div>
                </c:if>
              </li>
            </c:if>
          </c:forEach>
        </ul>
      </nav>

      <%-- Header Actions --%>
      <div class="header-actions">
        
        <%-- Search Form --%>
        <form id="topSearchForm" method="get" action="${ctx}/search" class="search-form" autocomplete="off">
          <div class="search-form-row">
            <input type="text" id="searchInput" name="query" value="<c:out value='${param.query}'/>" placeholder="Search..." class="search-input" autocomplete="off" />
            <button type="submit" class="search-submit" title="Search">
              <i class="${font:fas()} fa-search"></i>
            </button>
          </div>
          <div id="searchDropdownPanel" class="search-dropdown-panel" aria-hidden="true">
            <div id="searchResults" class="search-dropdown-results">Type at least 3 characters...</div>
          </div>
        </form>

        <%-- Region Filter Button --%>
        <c:if test="${!empty requestRegionList}">
          <button type="button" class="header-btn region-filter-trigger" title="Filter by Region" onclick="window.openRegionModal()">
            <i class="${font:fas()} fa-globe-americas"></i>
            <span class="btn-text">Region</span>
          </button>
        </c:if>

        <%-- Ask AI Button --%>
        <%-- Enable for Ask AI Drawer
        <button type="button" class="header-btn ask-ai-trigger" title="Ask AI" onclick="toggleAskAIDrawer()">
          <i class="${font:fas()} fa-brain"></i>
          <span class="btn-text">Ask AI</span>
        </button>
        --%>
        <a href="/ask-ai" class="header-btn" title="Ask AI">
          <i class="${font:fas()} fa-brain"></i>
          <span class="btn-text">Ask AI</span>
        </a>

        <%-- Cart (E-commerce) --%>
        <c:if test="${ecommerceEnabled}">
          <div class="cart-btn header-btn" title="Shopping Cart">
            <i class="${font:fas()} fa-shopping-cart"></i>
            <span class="btn-text">Cart</span>
            <c:if test="${cartItemCount > 0}">
              <span class="cart-badge">${cartItemCount}</span>
            </c:if>
            
            <%-- Cart Dropdown --%>
            <div class="cart-dropdown">
              <div class="cart-dropdown-header">
                Shopping Cart (${cartItemCount} items)
              </div>
              <div class="cart-dropdown-items">
                <c:choose>
                  <c:when test="${not empty cartItems}">
                    <c:forEach items="${cartItems}" var="item">
                      <div class="cart-item">
                        <c:if test="${not empty item.imageUrl}">
                          <img src="${item.imageUrl}" alt="${item.name}" class="cart-item-image">
                        </c:if>
                        <div class="cart-item-info">
                          <div class="cart-item-name">${item.name}</div>
                          <div class="cart-item-price">
                            ${item.quantity} x <fmt:formatNumber value="${item.price}" type="currency"/>
                          </div>
                        </div>
                      </div>
                    </c:forEach>
                  </c:when>
                  <c:otherwise>
                    <div style="padding: 2rem; text-align: center; color: var(--announcement-text);">
                      Your cart is empty
                    </div>
                  </c:otherwise>
                </c:choose>
              </div>
              <c:if test="${cartItemCount > 0}">
                <div class="cart-dropdown-footer">
                  <div style="display: flex; justify-content: space-between; margin-bottom: 1rem; font-weight: 600;">
                    <span>Total:</span>
                    <span><fmt:formatNumber value="${cartTotal}" type="currency"/></span>
                  </div>
                  <a href="/cart" class="button expanded">View Cart</a>
                  <a href="/checkout" class="button primary expanded">Checkout</a>
                </div>
              </c:if>
            </div>
          </div>
        </c:if>
        
        <%-- Contact Us Button --%>
        <a href="/contact-us" class="header-btn" title="Contact Us">
          <i class="${font:fas()} fa-envelope"></i>
          <span class="btn-text">Contact</span>
        </a>

        <%-- Language Selector --%>
        <%--
        <div class="language-selector">
          <button class="header-btn language-btn" title="Select Language">
            <i class="${font:fas()} fa-globe"></i>
            <span class="btn-text">${currentLanguage.code}</span>
            <i class="${font:fas()} fa-chevron-down" style="font-size: 0.75rem;"></i>
          </button>
          <div class="language-dropdown">
            <a href="?lang=en_US" class="language-option">
              <i class="${font:fas()} fa-check" style="margin-right: 0.5rem;"></i>
              US English
            </a>
            <c:forEach items="${availableLanguages}" var="lang">
              <a href="?lang=${lang.code}" class="language-option">
                <i class="${font:fas()} fa-check" style="margin-right: 0.5rem; ${lang.code == currentLanguage.code ? '' : 'visibility: hidden;'}"></i>
                ${lang.name}
              </a>
            </c:forEach>
          </div>
        </div>
        --%>

        <%-- User Section --%>
        <c:choose>
          <c:when test="${not empty userSession.user}">
            <%-- User Menu --%>
            <div class="user-menu">
              <div class="user-menu-trigger" title="User Menu">
                <i class="${font:fas()} fa-user-circle"></i>
                <span>${userSession.user.firstName} ${userSession.user.lastName}</span>
                <i class="${font:fas()} fa-chevron-down" style="font-size: 0.75rem;"></i>
              </div>
              
              <div class="user-menu-dropdown">

                <%-- Page and Site Section --%>
                <c:if test="${userSession.hasRole('admin') || userSession.hasRole('content-manager')}">
                <div class="user-menu-section">
                  <c:if test="${userSession.hasRole('admin') || userSession.hasRole('content-manager')}">
                  <div class="user-menu-section-title">Page Tools</div>
                  <div class="admin-apps-grid">
                    <a href="${ctx}/admin/web-page?webPage=${pageRenderInfo.pagePath}" class="admin-app-item" title="View page information">
                      <i class="${font:fas()} fa-info-circle"></i>
                      <span class="admin-app-item-label">Page Info</span>
                    </a>

                    <a href="${ctx}/page-analytics?webPage=${adminPagePath}" class="admin-app-item" title="View analytics for this page">
                      <i class="${font:fas()} fa-chart-area"></i>
                      <span class="admin-app-item-label">Page Analytics</span>
                    </a>
                  </div>
                  </c:if>
                </div>
                </c:if>

                <c:if test="${userSession.hasRole('admin') || userSession.hasRole('content-manager')}">
                <div class="user-menu-section">
                  <div class="user-menu-section-title">Page Design Tools</div>
                  <div class="admin-apps-grid">

                    <a href="${ctx}/admin/visual-page-editor?webPage=${masterWebPage.link}" class="admin-app-item" title="Edit page structure">
                      <i class="${font:fas()} fa-file-lines"></i>
                      <span class="admin-app-item-label">Page Design</span>
                    </a>

                    <c:if test="${userSession.hasRole('admin')}">
                      <a href="${ctx}/admin/css-editor?webPage=${masterWebPage.link}&returnPage=${masterWebPage.link}" class="admin-app-item" title="Edit page CSS styles">
                        <i class="${font:fab()} fa-css"></i>
                        <span class="admin-app-item-label">Page CSS</span>
                      </a>
                    </c:if>
                    
                    <a href="${ctx}/admin/web-page-designer?webPage=${masterWebPage.link}" class="admin-app-item" title="Edit page XML">
                      <i class="${font:fas()} fa-code"></i>
                      <span class="admin-app-item-label">Page XML</span>
                    </a>

                  </div>
                </div>
                </c:if>

                <c:if test="${userSession.hasRole('admin') || userSession.hasRole('content-manager')}">
                <div class="user-menu-section">
                  <div class="user-menu-section-title">Content Tools</div>
                  <div class="admin-apps-grid">

                    <a href="${ctx}/admin/visual-document-editor?returnPage=${pageRenderInfo.pagePath}" class="admin-app-item" title="Manage documents and file links">
                      <i class="${font:fas()} fa-folder-open"></i>
                      <span class="admin-app-item-label">All Files</span>
                    </a>

                    <a href="${ctx}/admin/visual-image-editor?returnPage=${pageRenderInfo.pagePath}" class="admin-app-item" title="Manage images and media">
                      <i class="${font:fas()} fa-image"></i>
                      <span class="admin-app-item-label">All Images</span>
                    </a>

                    <a href="${ctx}/admin/visual-hierarchy-editor?webPage=${pageRenderInfo.pagePath}" class="admin-app-item" title="Edit web page hierarchy and structure">
                      <i class="${font:fas()} fa-sitemap"></i>
                      <span class="admin-app-item-label">Page Hierarchy</span>
                    </a>

                  </div>
                </div>
                </c:if>

                <c:if test="${userSession.hasRole('admin') || userSession.hasRole('community-manager') || userSession.hasRole('content-manager') || userSession.hasRole('data-manager')}">
                <div class="user-menu-section">
                  <div class="user-menu-section-title">Admin Tools</div>
                  <div class="admin-apps-grid">

                    <a href="/site-instructions" class="admin-app-item" title="View administration information">
                      <i class="${font:fas()} fa-circle-info"></i>
                      <span class="admin-app-item-label">Instructions</span>
                    </a>

                    <c:if test="${userSession.hasRole('admin') || userSession.hasRole('content-manager')}">
                      <a href="${ctx}/admin/visual-analytics-dashboard" class="admin-app-item" title="View site analytics and reports">
                        <i class="${font:fas()} fa-chart-line"></i>
                        <span class="admin-app-item-label">Site Analytics</span>
                      </a>
                    </c:if>

                    <c:if test="${userSession.hasRole('admin') || userSession.hasRole('community-manager')}">
                      <a href="/admin/users" class="admin-app-item" title="Manage user accounts">
                        <i class="${font:fas()} fa-users"></i>
                        <span class="admin-app-item-label">Users</span>
                      </a>
                    </c:if>

                    <c:if test="${userSession.hasRole('admin')}">
                      <a href="${ctx}/admin/site-header-properties" class="admin-app-item" title="Change announcement banner message">
                        <i class="${font:fas()} fa-bullhorn"></i>
                        <span class="admin-app-item-label">Announcement</span>
                      </a>
                    </c:if>

                    <c:if test="${userSession.hasRole('admin')}">
                      <a href="${ctx}/admin/css-editor?returnPage=${pageRenderInfo.pagePath}" class="admin-app-item" title="Manage CSS styles">
                        <i class="${font:fab()} fa-css"></i>
                        <span class="admin-app-item-label">Site CSS</span>
                      </a>
                    </c:if>

                    <c:if test="${userSession.hasRole('admin')}">
                      <a href="/admin" class="admin-app-item" title="System configuration">
                        <i class="${font:fas()} fa-cog"></i>
                        <span class="admin-app-item-label">Setup</span>
                      </a>
                    </c:if>
                    
                  </div>
                </div>
                </c:if>

                <%-- User Actions Section --%>
                <div class="user-menu-section">

                  <a href="javascript:void(0);" onclick="toggleDarkMode()" class="user-menu-item" title="Toggle Light/Dark Mode">
                    <i class="${font:fas()} fa-moon" id="themeIconMenu"></i>
                    <div class="user-menu-item-content">
                      <span class="user-menu-item-label">Toggle Light/Dark Mode</span>
                    </div>
                  </a>     
                  
                  <a href="/account" class="user-menu-item">
                    <i class="${font:fas()} fa-user-cog"></i>
                    <div class="user-menu-item-content">
                      <span class="user-menu-item-label">My Account</span>
                    </div>
                  </a>
                  
                  <a href="/logout" class="user-menu-item">
                    <i class="${font:fas()} fa-sign-out-alt"></i>
                    <div class="user-menu-item-content">
                      <span class="user-menu-item-label">Logout</span>
                    </div>
                  </a>
                </div>
              </div>
            </div>
          </c:when>
          <c:otherwise>
            <%-- Theme Toggle --%>
            <button class="theme-toggle" onclick="toggleDarkMode()" title="Toggle Dark Mode" aria-label="Toggle Dark Mode">
              <i class="${font:fas()} fa-moon" id="themeIcon"></i>
            </button>
            <%-- Login --%>
            <a href="/login" class="header-btn primary" title="Login">
              <i class="${font:fas()} fa-sign-in-alt"></i>
              <span class="btn-text">Login</span>
            </a>
          </c:otherwise>
        </c:choose>

      </div>

      <%-- Mobile Menu Toggle --%>
      <button class="mobile-menu-toggle" onclick="toggleMobileMenu()" aria-label="Toggle Menu">
        <i class="${font:fas()} fa-bars"></i>
      </button>
    </div>
  </div>
</header>

<div id="searchBackdrop" class="search-backdrop" aria-hidden="true"></div>

<%-- Ask AI Drawer --%>
<%--
<div id="askAIDrawer" class="ask-ai-drawer">
  <div class="ask-ai-drawer-header">
    <h3><i class="${font:fas()} fa-brain"></i> Ask AI Assistant</h3>
    <button type="button" class="ask-ai-close" onclick="toggleAskAIDrawer()" aria-label="Close">
      <i class="${font:fas()} fa-times"></i>
    </button>
  </div>
  <div class="ask-ai-drawer-content">
    <div class="ask-ai-messages" id="askAIMessages">
      <div class="ask-ai-message ask-ai-message-system">
        <div class="ask-ai-message-icon">
          <i class="${font:fas()} fa-info-circle"></i>
        </div>
        <div class="ask-ai-message-text">
          <strong>AI Assistant Not Connected</strong>
          <p>The AI assistant service is currently not configured. Please contact your administrator to enable this feature.</p>
        </div>
      </div>
    </div>
    <div class="ask-ai-input-container">
      <form class="ask-ai-form" onsubmit="handleAskAISubmit(event)">
        <textarea 
          id="askAIInput" 
          class="ask-ai-input" 
          placeholder="Type your question here..." 
          rows="3"
          disabled
        ></textarea>
        <button type="submit" class="ask-ai-send" disabled title="AI assistant not connected">
          <i class="${font:fas()} fa-paper-plane"></i>
        </button>
      </form>
    </div>
  </div>
</div>
--%>

<%-- Region Filter Modal --%>
<c:if test="${!empty requestRegionList}">
  <div id="regionModal" class="region-modal">
    <div class="region-modal-content">
      <div class="region-modal-header">
        <h3><i class="${font:fas()} fa-globe-americas"></i> To get started, select your region / market:</h3>
        <button type="button" class="region-modal-close" onclick="window.closeRegionModal()" aria-label="Close">
          <i class="${font:fas()} fa-times"></i>
        </button>
      </div>
      <div class="region-modal-body">
        <form id="regionFilterForm" autocomplete="off">
          <%-- Region options will be generated by JavaScript --%>
          <div class="region-options" id="regionOptionsContainer">
          </div>
        </form>
      </div>
    </div>
  </div>
</c:if>

<script>
  // Mobile Menu Toggle
  function toggleMobileMenu() {
    const nav = document.getElementById('mainNav');
    nav.classList.toggle('show');
    
    const toggle = document.querySelector('.mobile-menu-toggle i');
    if (nav.classList.contains('show')) {
      toggle.classList.remove('fa-bars');
      toggle.classList.add('fa-times');
    } else {
      toggle.classList.remove('fa-times');
      toggle.classList.add('fa-bars');
    }
  }

  // Close mobile menu when clicking outside
  document.addEventListener('click', function(event) {
    const nav = document.getElementById('mainNav');
    const toggle = document.querySelector('.mobile-menu-toggle');
    
    if (nav.classList.contains('show') && 
        !nav.contains(event.target) && 
        !toggle.contains(event.target)) {
      toggleMobileMenu();
    }
  });

  function applyTheme(theme) {
    const header = document.querySelector('.modern-header');
    if (!header) {
      return;
    }
    header.setAttribute('data-theme', theme);
    document.documentElement.setAttribute('data-theme', theme);

    const icon = document.getElementById('themeIcon');
    const menuIcon = document.getElementById('themeIconMenu');
    [icon, menuIcon].forEach(function(el) {
      if (!el) {
        return;
      }
      if (theme === 'dark') {
        el.classList.remove('fa-moon');
        el.classList.add('fa-sun');
      } else {
        el.classList.remove('fa-sun');
        el.classList.add('fa-moon');
      }
    });
  }

  // Dark Mode Toggle
  function toggleDarkMode() {
    const header = document.querySelector('.modern-header');
    const currentTheme = header ? header.getAttribute('data-theme') : 'light';
    const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
    applyTheme(newTheme);
    localStorage.setItem('theme', newTheme);
  }

  function setupUserMenu() {
    const userMenu = document.querySelector('.user-menu');
    if (!userMenu) {
      return;
    }

    const trigger = userMenu.querySelector('.user-menu-trigger');
    const dropdown = userMenu.querySelector('.user-menu-dropdown');
    if (!trigger || !dropdown) {
      return;
    }

    let isOpen = false;

    function closeMenu() {
      if (!isOpen) {
        return;
      }
      isOpen = false;
      userMenu.classList.remove('open');
      document.removeEventListener('click', handleOutsideClick);
    }

    function handleOutsideClick(event) {
      if (!userMenu.contains(event.target)) {
        closeMenu();
      }
    }

    trigger.addEventListener('click', function(event) {
      event.preventDefault();
      event.stopPropagation();
      isOpen = !isOpen;
      userMenu.classList.toggle('open', isOpen);
      if (isOpen) {
        document.addEventListener('click', handleOutsideClick);
      } else {
        document.removeEventListener('click', handleOutsideClick);
      }
    });

    dropdown.addEventListener('click', function(event) {
      if (event.target.closest('a')) {
        closeMenu();
      }
    });
  }

  <%--
  // Ask AI Drawer Functions
  function toggleAskAIDrawer() {
    const drawer = document.getElementById('askAIDrawer');
    if (drawer) {
      drawer.classList.toggle('open');
    }
  }

  function handleAskAISubmit(event) {
    event.preventDefault();
    const input = document.getElementById('askAIInput');
    if (input && input.value.trim()) {
      // TODO: Send message to AI service when connected
      input.value = '';
    }
  }
  --%>

  // Load saved theme preference and initialize interactive menus
  document.addEventListener('DOMContentLoaded', function() {
    const header = document.querySelector('.modern-header');
    const savedTheme = localStorage.getItem('theme') || (header ? header.getAttribute('data-theme') : 'light');
    applyTheme(savedTheme || 'light');
    setupUserMenu();
  });

  // Sticky header scroll effect
  let lastScroll = 0;
  window.addEventListener('scroll', function() {
    const header = document.querySelector('.modern-header');
    const currentScroll = window.pageYOffset;
    
    if (currentScroll > lastScroll && currentScroll > 100) {
      // Scrolling down
      header.style.transform = 'translateY(-100%)';
    } else {
      // Scrolling up
      header.style.transform = 'translateY(0)';
    }
    lastScroll = currentScroll;
  });

  <%-- Dynamic Search Capability --%>

  document.addEventListener('DOMContentLoaded', () => {

    const MIN_CHARS = 3;
    const DEBOUNCE_DELAY = 300;

    const searchInput = document.getElementById('searchInput');
    const searchDropdownPanel = document.getElementById('searchDropdownPanel');
    const searchResults = document.getElementById('searchResults');
    const searchForm = document.getElementById('topSearchForm');
    const searchBackdrop = document.getElementById('searchBackdrop');

    let debounceTimer;
    let activeRequestId = 0;

    const positionSearchPanel = () => {
      const formRect = searchForm.getBoundingClientRect();
      const inputRect = searchInput.getBoundingClientRect();
      const panelTop = Math.max((inputRect.bottom - formRect.top) + 6, 8);
      const viewportPadding = 16;
      const panelWidth = Math.min(Math.max(320, window.innerWidth * 0.6), window.innerWidth - (viewportPadding * 2));
      const viewportCenterX = window.innerWidth / 2;
      const panelLeft = viewportCenterX - formRect.left;

      searchDropdownPanel.style.width = `\${panelWidth}px`;
      searchDropdownPanel.style.top = `\${panelTop}px`;
      searchDropdownPanel.style.left = `\${panelLeft}px`;
      searchDropdownPanel.style.transform = 'translateX(-50%)';
    };

    // Dropdown helpers
    const openSearchPanel = () => {
      positionSearchPanel();
      searchDropdownPanel.classList.add('is-open');
      searchDropdownPanel.setAttribute('aria-hidden', 'false');
      searchForm.classList.add('search-open');
      if (searchBackdrop) {
        searchBackdrop.classList.add('is-open');
        searchBackdrop.setAttribute('aria-hidden', 'false');
      }
    };

    const closeSearchPanel = () => {
      searchDropdownPanel.classList.remove('is-open');
      searchDropdownPanel.setAttribute('aria-hidden', 'true');
      searchForm.classList.remove('search-open');
      if (searchBackdrop) {
        searchBackdrop.classList.remove('is-open');
        searchBackdrop.setAttribute('aria-hidden', 'true');
      }
    };

    // Expose globally (used in HTML onclick)
    window.closeSearchModal = closeSearchPanel;

    // Utility: show message
    const showMessage = (msg) => {
      searchResults.innerHTML = `<p>\${msg}</p>`;
    };

    // Remove unwanted elements from HTML
    const cleanContent = (content) => {
      const removeSelectors = [
        '.landing-page-search',
        'form',
        'input',
        'button',
        'h2'
      ];

      removeSelectors.forEach(selector => {
        content.querySelectorAll(selector).forEach(el => el.remove());
      });

      return content;
    };

    const contextPath = "${ctx}";

    // Core search function
    const performSearch = async (query) => {
      const requestId = ++activeRequestId;

      try {
        showMessage('Loading...');

        const response = await fetch(`\${contextPath}/search?query=\${encodeURIComponent(query)}`);
        const html = await response.text();

        // Ignore out-of-order responses from stale queries
        if (requestId !== activeRequestId) {
          return;
        }

        const doc = new DOMParser().parseFromString(html, 'text/html');
        const content = doc.querySelector('.search-main-content');

        if (!content) {
          showMessage('No results found');
          return;
        }

        cleanContent(content);

        // Check results existence
        const resultLinks = content.querySelectorAll('a');
        if (!resultLinks.length) {
          showMessage('No results found');
          return;
        }

        // Inject cleaned content
        searchResults.innerHTML = content.innerHTML;

      } catch (error) {
        console.error('Search error:', error);
        showMessage('Error loading results');
      }
    };

    // Input handler with debounce
    const handleSearchInput = (e) => {
      const query = e.target.value.trim();

      if (query.length < MIN_CHARS) {
        closeSearchPanel();
        return;
      }

      openSearchPanel();

      clearTimeout(debounceTimer);
      debounceTimer = setTimeout(() => performSearch(query), DEBOUNCE_DELAY);
    };

    // Event delegation (better performance)
    searchResults.addEventListener('click', (e) => {
      if (e.target.closest('a')) {
        closeSearchPanel();
      }
    });

    // Event bindings
    searchInput.addEventListener('input', handleSearchInput);
    searchInput.addEventListener('focus', (e) => {
      const query = e.target.value.trim();
      if (query.length >= MIN_CHARS) {
        openSearchPanel();
      }
    });

    searchForm.addEventListener('submit', () => {
      closeSearchPanel();
    });

    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') {
        closeSearchPanel();
      }
    });

    document.addEventListener('click', (e) => {
      if (!searchForm.contains(e.target)) {
        closeSearchPanel();
      }
    });

    window.addEventListener('resize', () => {
      if (searchDropdownPanel.classList.contains('is-open')) {
        positionSearchPanel();
      }
    });

  });
</script>
