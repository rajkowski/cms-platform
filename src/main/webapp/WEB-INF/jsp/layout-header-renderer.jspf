<%@ taglib prefix="g" uri="http://granule.com/tags" %>
<c:if test="${headerRenderInfo.enabled and not empty headerRenderInfo.sectionRenderInfoList}">
  <g:compress><link rel="stylesheet" href="${ctx}/css/layout-header-modern.css"></g:compress>
  <%-- Site admin theme.topbar.* colors (light) and theme.topbar.dark.* colors (dark) --%>
  <c:set var="topbarVarMap" value="--header-bg=backgroundColor,--header-text=text.color,--nav-link-color=menu.text.color,--nav-arrow-color=menu.arrow.color,--nav-hover-bg=menu.text.hoverBackgroundColor,--nav-hover-text=menu.hoverTextColor,--nav-active-bg=menu.activeBackgroundColor,--nav-active-text=menu.activeTextColor,--nav-dropdown-bg=menu.dropdown.backgroundColor,--nav-dropdown-text=menu.dropdown.text.color" />
  <style>
    .modern-header:not([data-theme="dark"]){<c:forEach items="${fn:split(topbarVarMap, ',')}" var="topbarEntry"><c:set var="topbarPair" value="${fn:split(topbarEntry, '=')}" /><c:set var="topbarKey" value="theme.topbar.${topbarPair[1]}" /><c:set var="topbarValue" value="${themePropertyMap[topbarKey]}" /><c:if test="${not empty topbarValue}">${topbarPair[0]}:<c:out value="${topbarValue}" />;</c:if></c:forEach>}
    .modern-header[data-theme="dark"]{<c:forEach items="${fn:split(topbarVarMap, ',')}" var="topbarEntry"><c:set var="topbarPair" value="${fn:split(topbarEntry, '=')}" /><c:set var="topbarKey" value="theme.topbar.dark.${topbarPair[1]}" /><c:set var="topbarValue" value="${themePropertyMap[topbarKey]}" /><c:if test="${not empty topbarValue}">${topbarPair[0]}:<c:out value="${topbarValue}" />;</c:if></c:forEach>}
  </style>
  <header id="<c:out value='${headerRenderInfo.htmlId}'/>" class="modern-header<c:out value=' ${headerRenderInfo.cssClass}'/>" style="<c:out value='${headerRenderInfo.cssStyle}'/>" data-theme="<c:out value='${theme}'/>" data-header-modern data-header-sticky="${headerRenderInfo.sticky}" data-scroll-behavior="${headerRenderInfo.scrollBehavior}" data-scroll-threshold="${headerRenderInfo.scrollThreshold}">
    <c:forEach items="${headerRenderInfo.sectionRenderInfoList}" var="section">
      <c:set var="sectionVisibility" value="${section.visibility eq 'small' ? 'show-for-small-only' : section.visibility eq 'medium' ? 'show-for-medium' : section.visibility eq 'large' ? 'show-for-large' : ''}" />
      <div<c:if test="${not empty section.htmlId}"> id="<c:out value='${section.htmlId}'/>"</c:if> class="<c:out value='${section.cssClass}'/> ${sectionVisibility}" style="<c:out value='${section.cssStyle}'/>">
        <c:if test="${section.container ne 'none'}"><div class="<c:out value='${section.containerClass}'/>"></c:if>
        <c:forEach items="${section.columnRenderInfoList}" var="column">
          <c:set var="modernColumnId" value="${not empty column.htmlId ? column.htmlId : headerRenderInfo.htmlId.concat('-column-').concat(column.pageColumnCount)}" />
          <c:set var="columnVisibility" value="${column.visibility eq 'small' ? 'show-for-small-only' : column.visibility eq 'medium' ? 'show-for-medium' : column.visibility eq 'large' ? 'show-for-large' : ''}" />
          <c:set var="columnWrapped" value="${column.wrapper ne 'none' or not empty columnVisibility}" />
          <c:if test="${columnWrapped}">
            <div id="<c:out value='${modernColumnId}'/>" class="<c:out value='${column.cssClass}'/> ${columnVisibility}${column.wrapper eq 'none' ? ' header-visibility-scope' : ''}" style="<c:out value='${column.cssStyle}'/>"<c:if test="${column.sticky}"> data-sticky-container</c:if>>
          </c:if>
          <c:forEach items="${column.widgetRenderInfoList}" var="widget">
            <c:set var="widgetVisibility" value="${widget.visibility eq 'small' ? 'show-for-small-only' : widget.visibility eq 'medium' ? 'show-for-medium' : widget.visibility eq 'large' ? 'show-for-large' : ''}" />
            <c:set var="widgetWrapped" value="${not empty widgetVisibility or (widget.wrapper ne 'none' and (not empty widget.htmlId or not empty widget.cssClass or not empty widget.cssStyle or widget.sticky))}" />
            <c:if test="${widgetWrapped}">
              <div<c:if test="${not empty widget.htmlId}"> id="<c:out value='${widget.htmlId}'/>"</c:if> class="<c:out value='${widget.cssClass}'/> ${widgetVisibility}${widget.wrapper eq 'none' ? ' header-visibility-scope' : ''}" style="<c:out value='${widget.cssStyle}'/>"<c:if test="${widget.sticky}"> data-sticky data-margin-top="0" data-top-anchor="<c:out value='${modernColumnId}'/>"</c:if>>
            </c:if>
            ${widget.content}
            <c:if test="${widgetWrapped}"></div></c:if>
          </c:forEach>
          <c:if test="${columnWrapped}"></div></c:if>
        </c:forEach>
        <c:if test="${section.container ne 'none'}"></div></c:if>
      </div>
    </c:forEach>
  </header>
  <g:compress><script defer src="${ctx}/javascript/layout-header-modern.js"></script></g:compress>
</c:if>

