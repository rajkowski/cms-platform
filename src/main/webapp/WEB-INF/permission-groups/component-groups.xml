<?xml version="1.0"?>
<!--
  Maps widget and service Actions to their Cedar PermissionGroup.
  The PermissionEngine loads this file at startup and uses it to resolve which policy
  governs access to each Action. Actions are stable identifiers passed to
  PermissionEngine.checkAccess(action, userSession) by the widget/service code
  and are independent of the Java class name or package, so classes can be
  renamed or moved without breaking permission mappings.

  Attributes:
    action - stable Action identifier, dotted lowercase (e.g. "cms.content.save-draft")
    group  - Cedar PermissionGroup entity ID (must match a .cedar policy file name without extension)
    type   - WIDGET | SERVICE | REST
-->
